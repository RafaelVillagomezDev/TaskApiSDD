# Plantilla de variables de entorno (versionada, sin valores; CONSTITUTION.md, principio IV)
# Copiar a .env.dev o .env.prod y rellenar los valores
DATABASE_URL=
PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# SonarQube local (docker-compose.sonar.yml; scripts/sonar-setup.sh genera SONAR_TOKEN)
SONAR_ADMIN_PASSWORD=
SONAR_TOKEN=

# Cuentas de usuario (sdd/002, D-11): clave AES-256 de 64 caracteres hex (openssl rand -hex 32) y origen del frontend para CORS
SESSION_ENCRYPTION_KEY=
CORS_ORIGIN=
