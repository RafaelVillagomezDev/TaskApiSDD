{
  "name": "taskapisdd",
  "version": "0.1.0",
  "private": true,
  "description": "API REST para la gestión de tareas diarias y el seguimiento de rachas de productividad",
  "type": "module",
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite-node --watch src/server.main.ts",
    "build": "vite build",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:perf": "NODE_OPTIONS=--experimental-vm-modules JEST_PERFORMANCE=1 jest --selectProjects=performance",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "express": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-node": "6.0.0"
  }
}
