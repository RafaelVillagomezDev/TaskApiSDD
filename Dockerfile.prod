# Imagen de producción multi-stage (plan, sección 3; T028). Todas las fechas del proceso en UTC (R-4)

# 1. build: dependencias completas, cliente de Prisma y build SSR con Vite (dist/server.js).
#    También la usa el servicio `migrate` de docker-compose.prod.yml, porque conserva el CLI de prisma
FROM node:22-alpine AS build
ENV TZ=UTC CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=true CI=true
# Prisma necesita OpenSSL en Alpine
RUN apk add --no-cache openssl && corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm prisma generate && pnpm build

# 2. prod-deps: quita las dependencias de desarrollo y conserva el cliente de Prisma ya generado
FROM build AS prod-deps
RUN pnpm prune --prod --ignore-scripts

# 3. runtime: solo dependencias de producción, dist/ y prisma/
FROM node:22-alpine AS runtime
ENV TZ=UTC NODE_ENV=production CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=true
RUN apk add --no-cache openssl
WORKDIR /app
COPY --from=prod-deps /app/package.json ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
# El proceso no se ejecuta como root
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
