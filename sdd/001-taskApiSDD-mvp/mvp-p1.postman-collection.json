{
  "info": {
    "name": "TaskApiSDD — MVP P1",
    "description": "Flujo del MVP P1 (H1 tareas del día, H2 completar, H3 racha) y casos de error. Las cabeceras X-User-Id, X-Client-Time y X-Timezone se calculan solas. Ejecuta la carpeta '1. Flujo MVP' en orden (Run folder) antes de '2. Errores'. La carpeta '3. Mis tareas' consulta las tareas del usuario de la variable myUserId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Calcula X-Client-Time (hora local con ±HH:MM) y las fechas locales en cada petición",
          "const pad = (n) => String(Math.abs(n)).padStart(2, '0');",
          "const now = new Date();",
          "const offset = -now.getTimezoneOffset();",
          "const sign = offset >= 0 ? '+' : '-';",
          "pm.variables.set('clientTime',",
          "  `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}` +",
          "  `${sign}${pad(Math.floor(Math.abs(offset) / 60))}:${pad(Math.abs(offset) % 60)}`);",
          "const day = (delta) => {",
          "  const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + delta);",
          "  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "};",
          "pm.variables.set('today', day(0));",
          "pm.variables.set('tomorrow', day(1));",
          "pm.variables.set('yesterday', day(-1));",
          "if (!pm.collectionVariables.get('userId')) {",
          "  pm.collectionVariables.set('userId', 'postman-' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "timeZone",
      "value": "Europe/Madrid"
    },
    {
      "key": "myUserId",
      "value": "mi-usuario"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "tomorrowTaskId",
      "value": ""
    }
  ],
