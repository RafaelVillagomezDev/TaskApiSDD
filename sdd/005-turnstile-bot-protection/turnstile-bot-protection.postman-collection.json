          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "05 Login con un campo desconocido → se ignora y entra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
